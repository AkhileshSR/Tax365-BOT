# Telegram BotFather token. Keep private.
TELEGRAM_BOT_TOKEN=PASTE_BOTFATHER_TOKEN_HERE

# Telegram numeric user IDs, comma-separated. Start with your own ID.
# Use /whoami in the bot to discover your numeric ID.
ALLOWED_TELEGRAM_USER_IDS=

# Paths are relative to this project root unless absolute.
DATA_DIR=../data
DATABASE_PATH=database/tax365.db
ARTIFACTS_DIR=artifacts
LOG_DIR=logs

# AnythingLLM local API. Leave enabled only after configuring its API key.
ANYTHINGLLM_ENABLED=false
ANYTHINGLLM_BASE_URL=http://localhost:3001
ANYTHINGLLM_API_KEY=
ANYTHINGLLM_WORKSPACE_SLUG=global-tax-intelligence
ANYTHINGLLM_TIMEOUT_SECONDS=45

# Demo configuration
ORGANIZATION_NAME=Illustrative Global Agri-Food Group
